# Copy this to infra/.env on the VPS and fill in real values. Never commit the real .env -
# it's already covered by .gitignore's `.env` pattern; double check before committing anyway.

# --- Core secrets --------------------------------------------------------------
POSTGRES_USER=bima
POSTGRES_PASSWORD=changeme-generate-a-real-password
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=changeme-generate-a-real-password
MINIO_ROOT_USER=bima
MINIO_ROOT_PASSWORD=changeme-generate-a-real-password
MINIO_BUCKET=bima-documents

# Let's Encrypt renewal-notice email for Caddy - optional, falls back to
# webmaster@bimacare.online if unset.
CADDY_EMAIL=

# The bima-gateway confidential client's secret in Keycloak (realm-export.json / the admin
# console) - used for service-to-service calls, e.g. eligibility-service validating a
# patient/org reference against another service.
BIMA_GATEWAY_CLIENT_SECRET=changeme-must-match-the-keycloak-client-secret

# The bima-iam-provisioner confidential client's secret - iam-service uses this to call the
# Keycloak Admin REST API when provisioning a per-patient account (Workstream B).
IAM_PROVISIONER_CLIENT_ID=bima-iam-provisioner
IAM_PROVISIONER_CLIENT_SECRET=changeme-must-match-the-keycloak-client-secret

# --- Public URLs -----------------------------------------------------------------
# The browser talks to Keycloak directly for login (direct-grant flow), so every backend
# service AND the web build must be configured with the SAME externally-reachable Keycloak
# URL the browser used - otherwise the JWT's "iss" claim won't match what each service
# expects and every request 401s. KEYCLOAK_HOSTNAME (bare hostname, no scheme) feeds
# Keycloak's own --hostname flag directly - derived from PUBLIC_KEYCLOAK_URL in ci.yml's
# deploy job when this is rendered by CI, but set explicitly here since this file is also
# the reference for what real values should look like.
PUBLIC_KEYCLOAK_ISSUER=https://auth.bimacare.online/realms/bima-care
KEYCLOAK_HOSTNAME=auth.bimacare.online

# CORS origin the gateway allows requests from - just the host, no scheme, matching
# gateway/src/main/kotlin/care/bima/gateway/Application.kt's WEB_APP_ORIGIN handling.
PUBLIC_WEB_ORIGIN=bimacare.online

# --- Image source (used by docker-compose.apps.yml, rendered by ci.yml's deploy job) ---
IMAGE_PREFIX=docker.io/YOUR_DOCKERHUB_USERNAME/bima-care
IMAGE_TAG=latest

# --- Demo identity mapping (see DemoProviderIdentityResolver) ---
# Empty until you've onboarded real providers on this deployment and captured their
# practitionerId/organizationId - format documented in the resolver's source. Insurers no
# longer need this - they get a real organizationId JWT claim via Keycloak provisioning.
DEMO_PROVIDER_IDENTITIES=
